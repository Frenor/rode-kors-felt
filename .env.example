# ═══════════════════════════════════════════════
# RKF Environment Variables
# Copy to .env.local and fill in values
# ═══════════════════════════════════════════════

# ─── API ────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# ─── Database ───────────────────────────────
DATABASE_URL=postgresql://rkf_dev:rkf_dev_password@localhost:5432/rkf

# ─── Redis ──────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ───────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── CORS ───────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── Sentry ─────────────────────────────────
# SENTRY_DSN=

# ─── AI Assist (Sick Bay 113) ───────────────
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=

# ─── Map Runtime Config (event-keyed JSON) ──
# Example structure:
# {
#   "default": { "provider": "leaflet" },
#   "events": {
#     "<event-id>": {
#       "provider": "maplibre",
#       "styleUrl": "https://example.com/style.json",
#       "enable3d": true,
#       "layers": [
#         { "id": "base", "type": "xyz", "url": "https://tiles/{z}/{x}/{y}.png" }
#       ],
#       "indoorLayout": {
#         "venueId": "arena-1",
#         "venueName": "Innendørs Arena",
#         "floors": [
#           {
#             "id": "f1",
#             "label": "Plan 1",
#             "zones": [
#               { "id": "z-a", "label": "Sone A", "center": { "lat": 59.9, "lng": 10.7 } }
#             ]
#           }
#         ]
#       }
#     }
#   }
# }
# MAP_CONFIG_JSON=

# ─── AWS (production only) ──────────────────
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
