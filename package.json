{
  "name": "rkf",
  "version": "0.1.0",
  "private": true,
  "description": "Rødt Kors Felt — Event Medical System",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --parallel --filter @rkf/* dev",
    "build": "pnpm --filter @rkf/* build",
    "lint": "pnpm --filter @rkf/* lint",
    "lint:fix": "pnpm --filter @rkf/* lint:fix",
    "typecheck": "pnpm --filter @rkf/* typecheck",
    "test": "pnpm --filter @rkf/* test",
    "test:e2e": "pnpm --filter @rkf/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm --filter @rkf/* clean && rm -rf node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.46.1",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "eslint": "^9.37.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.0",
    "turbo": "^2.3.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  }
}
