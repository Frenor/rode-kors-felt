# ═══════════════════════════════════════════════
# RKF API — Multi-stage Dockerfile
# Target: AWS ECS Fargate (eu-central-1)
# ═══════════════════════════════════════════════

# — Stage 1: Install dependencies —
FROM node:20-alpine AS deps
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app
# Skip husky's `prepare` lifecycle script — no .git/ exists in this build
# context, so `husky` would fail before sources are even copied in.
ENV HUSKY=0
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/api/package.json apps/api/
COPY packages/shared-types/package.json packages/shared-types/
RUN pnpm install --frozen-lockfile --filter @rkf/api --filter @rkf/shared-types

# — Stage 2: Build —
FROM node:20-alpine AS build
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app
ENV HUSKY=0
ENV CI=true
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=deps /app/packages/shared-types/node_modules ./packages/shared-types/node_modules
COPY . .
RUN pnpm --filter @rkf/api build
# `pnpm deploy` assembles a self-contained directory (dist/, package.json,
# a real node_modules — not the symlink farm pnpm normally uses in a
# workspace). Copying apps/api/node_modules directly would carry symlinks
# into /app/node_modules/.pnpm/... that don't exist in the production
# stage, leaving the image unable to start.
RUN pnpm --filter @rkf/api --prod deploy /prod/api

# — Stage 3: Production —
FROM node:20-alpine AS production
RUN apk add --no-cache tini
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000

COPY --from=build --chown=node:node /prod/api /app

USER node
EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost:4000/health || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/server.js"]
